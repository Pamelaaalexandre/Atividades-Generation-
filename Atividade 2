programa
{
	
	funcao inicio()
	{
		inteiro num[10] = {2,5,1,3,4,9,7,8,10,6},x,soma
		real media

		soma=0

		para (x=0;x<10;x++){
			escreva("Digite o número", x+1,":")
			leia(num[x])
		}
		escreva("\nElementos pares:\n")

		para(x=0;x<10;x++){
			se(x % 2 !=0){
				escreva(num[x])
		}
		escreva("\nElementos pares:\n")

		para(x=0;x<10;x++){
			se(num[x]%2==0){
				escreva(num[x],"\n")
			}
		}
		para(x=0;x<10;x++){
			soma=soma+num[x]
		}
		escreva("\nSoma: ", soma)

		media = soma / 10.0

		escreva("\nMedia: ", media)
		}
	}
}
